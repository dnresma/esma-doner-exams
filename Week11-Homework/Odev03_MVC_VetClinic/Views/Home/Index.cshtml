@using Odev03_MVC_VetClinic.Models.Entities;
@model List<Pet>
@{
    ViewData["Title"] = "Home Page";
}

<h1 class="text-center mb-5 text-decoration-underline">Veterinerimizdeki Toplam Hayvan Sayısı: @Model.Count()</h1>
<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Name</th>
            <th>Species</th>
            <th>Age</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var pet in Model)
        {
            <tr>
                <th scope="row">@pet.Id</th>
                <td>@pet.Name</td>
                <td>@pet.Species</td>
                <td>@pet.Age</td>
            </tr>
        }
    </tbody>
</table>