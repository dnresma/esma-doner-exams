@using EShopApp.Models.ViewModels.Categories
@model AdminUpdateCategoryViewModel
@{
    ViewData["Title"] = "Kategori Düzenle";
}

<div class="d-flex justify-content-between align-items-end">
    <h3 class="display-6 mb-3">Kategori Güncelle</h3>
    <div class="d-flex gap-3">
        <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="btn" style="background-color: #000; color: #fff;">Kategorilere Geri Dön</a>
    </div>
</div>

<div class="container">
    <form asp-area="Admin" asp-controller="Category" asp-action="Edit" method="post" enctype="multipart/form-data"
          novalidate data-ajax-category-form>
          <input type="hidden" asp-for="Id">
        <div class="row">
            <div asp-validation-summary="ModelOnly" class="text-danger mt-5" data-valsummary></div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label" asp-for="Name"></label>
                    <input class="form-control border-3" asp-for="Name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Description"></label>
                    <textarea asp-for="Description" class="form-control border-3" rows="5"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>
        </div>
        <button type="submit" class="btn mt-3" style="background-color: #000; color: #fff;">Güncelle</button>
    </form>
</div>


@section Scripts {
    <script src="~/js/category-form.js"></script>
}