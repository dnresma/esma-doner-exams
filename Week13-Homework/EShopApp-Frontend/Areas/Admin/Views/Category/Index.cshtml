@using EShopApp.Models.ViewModels.Categories
@model CategoriesIndexViewModel
@{
    ViewData["Title"] = "Kategoriler";
}

<div class="d-flex justify-content-between align-items-end">
    <h3 class="display-6">Kategori Yönetimi</h3>
    <div class="d-flex gap-3">
        <a asp-area="Admin" asp-controller="Category" asp-action="Create" class="btn" style="background-color: #000; color:#fff; margin-bottom: 20px;">Kategori Ekle</a>
    </div>
</div>
<table class="table table-responsive mt-3">
    <thead>
        <tr>
            <th>Id</th>
            <th>Kategori</th>
            <th>Ürün Adedi</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model.Categories)
        {
            <tr>
                <td>@c.Id</td>
                <td>@c.Name</td>
                <td>@c.ProductCount</td>
                <td class="">
                    <a asp-area="Admin" asp-controller="Category" asp-action="Edit" asp-route-id="@c.Id"
                    class="btn btn-warning btn-sm">Düzenle</a>
                    <a asp-area="Admin" asp-controller="Category" asp-action="Delete" asp-route-id="@c.Id"
                    class="btn btn-danger btn-sm">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>
