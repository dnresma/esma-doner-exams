@using EShopApp.Models.ViewModels.Admin
@model AdminIndexViewModel
@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="admin-dashboard">
    <div class="dashboard-header">
        <h1 class="">Admin Ana Sayfası</h1>
        <p>Mağazanın genel durumuna hoş geldiniz.</p>
    </div>
    <div class="dashboard-cards">
        <div class="dashboard-card">
            <div class="card-icon products-icon">📦</div>
            <p>Toplam Ürün:</p>
            <h2>@Model.TotalProducts</h2>
        </div>

        <div class="dashboard-card">
            <div class="card-icon orders-icon">🛍️</div>
            <p>Toplam Sipariş</p>
            <h2>@Model.TotalOrders</h2>
        </div>

        <div class="dashboard-card">
            <div class="card-icon sales-icon">💰</div>
            <p>Toplam Satış</p>
            <h2>@Model.TotalSales.ToString("C2")</h2>
        </div>
    </div>
    <div class="dashboard-cards">
</div>