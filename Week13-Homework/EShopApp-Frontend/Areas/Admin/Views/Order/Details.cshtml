@using EShopApp.Models.Enums
@using EShopApp.Models.ViewModels.Orders
@model DetailsOrderViewModel
@{
    ViewData["Title"] = $"Sipariş Detayı : #{Model.Id}";
    var status = Context.Request.Query["status"].ToString();
}

<div class="d-flex justify-content-between align-items-end">
    <h3 class="display-6 text-black mb-0">Sipariş Detayı: <span class="text-danger">#@Model.Id</span></h3>
    <a class="btn btn-dark" asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-status="@status">Siparişlere Dön</a>
</div>
<hr />
<div class="row g-5">
    <div class="col-md-5">
        <p><strong>Durum: </strong><span class="badge p-2 @Model.Status.ToBadgeClass()">@Model.Status.ToText()</span></p>
        <p><strong>Tarih: </strong>@Model.OrderDate.ToString("dd.MM.yyyy HH:mm")</p>
        <p><strong>Müşteri: </strong>@Model.CustomerName (@Model.CustomerEmail)</p>
        <p><strong>Teslimat Adresi: </strong>@Model.ShippingAddress</p>
        <p><strong>Telefon: </strong>@Model.PhoneNumber</p>

        @if (Model.NextStatuses.Any())
        {
            <form asp-area="Admin" asp-controller="Order" asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" novalidate data-ajax-form data-confirm="Sipariş durumu değiştirilsin mi?">
                <div class="text-danger mb-2" data-valsummary></div>
                <label class="form-label">Sipariş Durumunu Değiştir</label>
                <div class="d-flex gap-2 justify-content-start align-items-end">
                    <select class="form-select border-3" style="max-width: 150px;" name="status" id="status">
                        @foreach(var next in Model.NextStatuses)
                        {
                            <option value="@next">@next.ToText()</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-outline-primary">Güncelle</button>
                </div>
                <div class="form-text mt-2">İptal edilen siparişteki ürünler, stoğa geri eklenir.</div>
            </form>
        } else
        {
            <div class="alert alert-secondary">Bu sipariş İptal edildiği için, artık durumu değiştirilemez.</div>
        }
    </div>
    <div class="col-md-7">
        <table class="table table-sm align-middle">
            <tbody>
                @foreach(var line in Model.Lines)
                {
                    <tr>
                        <td><img src="@line.ImageUrl" style="height: 40px;" /></td>
                        <td>@line.ProductName</td>
                        <td>@line.Quantity x @line.UnitPrice.ToString("C2")</td>
                        <td class="text-end">@line.LineTotal.ToString("C2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3" class="text-end fw-bold">Toplam: </td>
                    <td class="text-end"><span class="fw-bold text-success fs-5">@Model.Total.ToString("C2")</span></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

@section Scripts{
    <script src="~/js/ajax-form.js"></script>
}