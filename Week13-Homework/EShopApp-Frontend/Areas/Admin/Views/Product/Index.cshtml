@using EShopApp.Models.ViewModels.Products
@model AdminProductsIndexViewModel
@{
    ViewData["Title"] = "Ürünler";
}

<div class="d-flex justify-content-between align-items-end">
    <h3 class="display-6">Ürün Yönetimi</h3>
    <div class="d-flex gap-3">
        <form asp-area="Admin" asp-controller="Product" asp-action="Index" method="get">
            <select class="form-select" name="categoryId" style="min-width: 200px;  border-color: #000; border-width: 2px; border-style: solid; margin-bottom: 20px;" onchange=this.form.submit()>
                <option value="">Tüm Kategoriler</option>
                @foreach (var category in Model.Categories)
                {
                    if (Model.SelectedCategoryId == category.Id)
                    {
                        <option selected value="@category.Id">@category.Name (@category.ProductCount)</option>
                    }
                    else
                    {
                        <option value="@category.Id">@category.Name (@category.ProductCount)</option>
                    }
                    
                }
            </select>
        </form>
        <a asp-area="Admin" asp-controller="Product" asp-action="Create" class="btn" style="background-color: #000; color:#fff; margin-bottom: 20px;">Ürün Ekle</a>
    </div>
</div>
<table class="table table-responsive mt-3">
    <thead>
        <tr>
            <th>Id</th>
            <th>Resim</th>
            <th>Ürün</th>
            <th>Fiyat</th>
            <th>Stok</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.Products)
        {
            <tr>
                <td>@p.Id</td>
                <td>
                    <img src="@p.ImageUrl" style="height: 30px;" />
                </td>
                <td>@p.Name</td>
                <td>@p.Price.ToString("C2")</td>
                <td>@p.StockQuantity</td>
                <td>
                    <a asp-area="Admin" asp-controller="Product" asp-action="Edit" asp-route-id="@p.Id"
                       class="btn btn-warning btn-sm">Düzenle</a>
                    <a asp-area="Admin" asp-controller="Product" asp-action="Delete" asp-route-id="@p.Id"
                       class="btn btn-danger btn-sm">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>