@using EShopApp.Models.ViewModels.Account
@model AccountIndexViewModel

@{
    ViewData["Title"] = "Hesap Ayarları";
    var initial = string.IsNullOrWhiteSpace(Model.FullName) ? "?" : Model.FullName.Trim()[0].ToString().ToUpper();
}


<div class="container my-4">
    <h4 class="fw-bold py-3 mb-4">Hesap Ayarları</h4>
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    <div class="card overflow-hidden bg-white">
        <div class="row g-0">
            <div class="col-md-3 border-end">
                <div class="list-group list-group-flush account-settings-links">
                    <a class="list-group-item list-group-item-action active" data-bs-toggle="list" href="#account-general">Genel</a>
                    <a class="list-group-item list-group-item-action" asp-area="" asp-controller="Account" asp-action="ChangePassword">Şifre Değiştir</a>
                </div>
            </div>

            <div class="col-md-9">
                <div class="tab-content">
                    <div class="tab-pane fade show active" id="account-general">
                        <div class="card-body d-flex align-items-center">
                            <div class="avatar-circle">@initial</div>
                            <div class="ms-4">
                                <h5 class="mb-0">@Model.FullName</h5>
                                <div class="text-muted small">@Model.Email</div>
                            </div>
                        </div>
                        <hr class="m-0">

                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label">Ad Soyad</label>
                                <input type="text" class="form-control" value="@Model.FullName" readonly>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Kullanıcı Adı</label>
                                <input type="text" class="form-control" value="@Model.UserName" readonly>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">E-posta</label>
                                <input type="text" class="form-control" value="@Model.Email" readonly>
                                @if (!Model.EmailConfirmed)
                                {
                                    <div class="alert alert-warning mt-3 mb-0">
                                        E-posta adresiniz doğrulanmamış.
                                    </div>
                                }
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Telefon</label>
                                <input type="text" class="form-control"
                                       value="@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Belirtilmemiş" : Model.PhoneNumber)" readonly>
                            </div>
                        </div>
                    <div class="card-footer text-end">
                        <a asp-action="Edit" class="btn btn-primary">Bilgilerimi Düzenle</a>
                    </div>
                    </div>
                    <div class="tab-pane fade" id="account-change-password">
                        <form asp-action="ChangePassword" method="post">
                            <div class="card-body pb-2">
                                <div class="mb-3">
                                    <label class="form-label">Mevcut şifre</label>
                                    <input type="password" name="CurrentPassword" class="form-control" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Yeni şifre</label>
                                    <input type="password" name="NewPassword" class="form-control" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Yeni şifre (tekrar)</label>
                                    <input type="password" name="ConfirmPassword" class="form-control" required>
                                </div>
                            </div>
                            <div class="card-footer text-end">
                                <button type="submit" class="btn btn-primary">Şifreyi Değiştir</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>