@using EShopApp.Models.ViewModels.Account
@model LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="row justify-content-center">
    <div class="col-md-3">
        <h3 class="display-6 text-primary mt-5 mb-3 fw-medium">Giriş Yap</h3>
        <form asp-area="" asp-controller="Account" asp-action="Login" method="post" data-ajax-form>
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="text-danger" data-valsummary></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control border-3">
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control border-3">
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input border-3" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>
            <button type="submit" class="btn btn-primary w-100">Giriş Yap</button>
        </form>
        <p class="mt-3">Hesabınız yok mu? <a asp-area="" asp-controller="Account" asp-action="Register">Kayıt olun</a></p>
    </div>
</div>

@section Scripts{
    <script src="~/js/ajax-form.js"></script>
}