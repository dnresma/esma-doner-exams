@using EShopApp.Models.Enums
@using EShopApp.Models.ViewModels.Orders
@model DetailsOrderViewModel
@{
    ViewData["Title"] = $"Sipariş #{Model.Id}";
}

<div class="d-flex justify-content-between align-items-end mb-3">
    <h1 class="mt-3 mb-0" style="color: #233351;">Sipariş @Model.Id</h1>
    <a asp-area="" asp-controller="Order" asp-action="Index" class="btn btn-outline-secondary">Siparişlerime Dön</a>
</div>

<div class="row g-4 mt-3">
    <div class="col-md-5">
        <p>
            <strong>Durum: </strong>
            <span class="badge @Model.Status.ToBadgeClass()">@Model.Status.ToText()</span>
        </p>
        <p>
            <strong>Tarih: </strong> @Model.OrderDate.ToString("dd.MM.yyyy HH:mm")
        </p>
        <p>
            <strong>Teslimat Adresi: </strong> @Model.ShippingAddress
        </p>
        <p>
            <strong>Telefon: </strong> @Model.PhoneNumber
        </p>
        @if (Model.CanCancel)
        {
            <form asp-area="" asp-controller="Order" asp-action="Cancel" asp-route-id="@Model.Id" method="post" novalidate data-ajax-form data-confirm="Siparişi iptal etmek istediğinizden emin misiniz?">
                <div class="text-danger mb-2" data-valsummary></div>
                <button type="submit" class="btn btn-outline-danger">Siparişi İptal Et</button>
            </form>
        }
    </div>
    <div class="col-md-7">
        <table class="table table-sm align-middle">
            <tbody>
                @foreach(var line in Model.Lines)
                {
                    <tr>
                        <td><img src="@line.ImageUrl" style="height:40px;" /></td>
                        <td>
                            <a asp-area="" asp-controller="Product" asp-action="Details" asp-route-id="@line.ProductId" style="text-decoration:none; color:#000; font-weight: bold;">@line.ProductName</a>
                        </td>
                        <td>@line.Quantity x @line.UnitPrice.ToString("C2")</td>
                        <td class="text-end">@line.LineTotal.ToString("C2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end fs-4">Toplam:</th>
                    <th class="text-end fs-5 text-success">@Model.Total.ToString("C2")</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div> 

@section Scripts{
    <script src="~/js/ajax-form.js"></script>
}