@using EShopApp.Models.Enums
@using EShopApp.Models.ViewModels.Orders
@model OrdersIndexViewModel
@{
    ViewData["Title"] = "Index";
}
<div class="d-flex justify-content-between align-items-end">
    <h2 class="mt-3 mb-3" style="color: #233351;">SİPARİŞLER</h2>
    <form asp-area="" asp-controller="Order" asp-action="Index" >
        <select class="form-select" name="orderStatus" style="min-width: 100px;  border-color: #233351;; border-width: 2px; border-style: solid; margin-top: 15px;" onchange="this.form.submit()"> 
            <option value="">Tümü</option>
            @foreach(var status in Model.OrderStatuses)
            {
                <option selected="@(Model.SelectedOrderStatus==status)" value="@status">@status.ToText()</option>
            }
        </select>
    </form>
</div>


@if(!Model.Orders.Any() && Model.SelectedOrderStatus is not null)
{
    <div class="alert alert-info mt-3">
        Henüz @Model.SelectedOrderStatus?.ToText() durumunda siparişiniz bulunmamaktadır.
    </div>
    <a asp-area="" asp-controller="Product" asp-action="Index" class="btn btn-primary">Alışverişe Başla</a>
}
else if (!Model.Orders.Any())
{
    <div class="alert alert-info mt-3">
        Henüz siparişiniz bulunmamaktadır.
    </div>
    <a asp-area="" asp-controller="Product" asp-action="Index" class="btn btn-primary">Alışverişe Başla</a>
} else
{
    <table class="table align-middle">
        <thead>
            <th>Sipariş No</th>
            <th>Tarih</th>
            <th>Ürün Adedi</th>
            <th>Tutar</th>
            <th>Durum</th>
            <th></th>
        </thead>
        <tbody>
            @foreach(var order in Model.Orders)
            {
                <tr>
                    <td>@order.Id</td>
                    <td>@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@order.ItemCount</td>
                    <td>@order.Total.ToString("C0")</td>
                    <td>
                        <span class="badge p-2 @order.Status.ToBadgeClass()">@order.Status.ToText()</span>
                    </td>
                    <td>
                        <a asp-area="" asp-controller="Order" asp-action="Details" asp-route-id="@order.Id" class="btn btn-outline-primary btn-sm">Detay</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}