@using EShopApp.Models.ViewModels.Products
@model ProductsIndexViewModel
@{
    ViewData["Title"] = "Ürünler";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mt-4" style="border-color: #233351;">TÜM ÜRÜNLER</h1>
        <form asp-area="" asp-controller="Product"asp-action="Index" method="get">
            <select class="form-select" name="categoryId" style="min-width: 200px;  border-color: #233351;; border-width: 2px; border-style: solid; margin-top: 15px;" onchange="this.form.submit();">
                <option value="">Tüm Kategoriler</option>
                @foreach (var category in Model.Categories)
                {
                    if (Model.SelectedCategoryId == category.Id)
                    {
                        <option selected value="@category.Id">@category.Name (@category.ProductCount)</option>
                    }
                    else
                    {
                        <option value="@category.Id">@category.Name (@category.ProductCount)</option>
                    }
                    
                }
            </select>
        </form>


    </div>

    @if (!Model.Products.Any())
    {
        <div class="alert alert-warning">
            Ürün kaydı bulunamadı!
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach(var p in Model.Products)
            {
                <div class="col-md-4 col-lg-3">
                    @await Html.PartialAsync("_ProductCardDetailPartial", p)
                </div>
            }
        </div>
    }

</div>